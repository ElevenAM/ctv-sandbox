# Copy to .env.local and fill. .env.local is gitignored — never commit real values.
# Both of these are PUBLIC by design (they ship in the client bundle). The
# service-role / secret key is NOT here and must never enter this repo.

# Supabase project: ctv-sandbox (ref thibkcpuvbskzznconzg, ca-central-1)
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: shown in the library footer so a deployed build is always traceable.
NEXT_PUBLIC_SITE_NAME="CTV Sandbox"
